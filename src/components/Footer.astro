---
import { siteConfig } from '../consts';

const currentYear = new Date().getFullYear();
const yearText = siteConfig.since ? `${siteConfig.since}–${currentYear}` : String(currentYear);
---

<footer class="section-divider blog-footer">
  <p>&copy; {yearText} {siteConfig.title}</p>
  <p class="blog-footer-credit">
    设计灵感源自
    <a
      href="https://github.com/Acris/hexo-theme-shiro"
      class="link-muted"
      target="_blank"
      rel="noopener noreferrer"
    >Shiro</a>
  </p>
</footer>
