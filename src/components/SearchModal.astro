---
import type { SearchIndexItem } from '../types/search';

interface Props {
  searchIndex: SearchIndexItem[];
  postCount: number;
}

const { searchIndex, postCount } = Astro.props;
const searchIndexJson = JSON.stringify(searchIndex);
---

<dialog id="search-modal" class="search-modal" aria-labelledby="search-modal-title">
  <div class="search-modal-panel">
    <header class="search-modal-header">
      <h2 id="search-modal-title" class="search-modal-title">搜索</h2>
      <button id="search-modal-close" type="button" class="search-modal-close" aria-label="关闭搜索">
        <svg class="size-5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true">
          <path d="M18 6L6 18M6 6l12 12" stroke-linecap="round"/>
        </svg>
      </button>
    </header>
    <input
      id="search-modal-input"
      type="search"
      class="search-input"
      placeholder="输入关键词搜索..."
      autocomplete="off"
      autofocus
    />
    <p class="search-modal-hint text-muted">在 {postCount} 篇文章中搜索</p>
    <div id="search-modal-results" class="search-modal-results space-y-3"></div>
    <p id="search-modal-empty" class="text-muted hidden py-8 text-center">未找到结果</p>
  </div>
</dialog>

<script id="search-index" type="application/json" set:html={searchIndexJson} />

<script>
  import { initSearchModal } from '../scripts/search';

  const dataEl = document.getElementById('search-index');
  if (dataEl?.textContent) {
    initSearchModal(JSON.parse(dataEl.textContent));
  }
</script>
