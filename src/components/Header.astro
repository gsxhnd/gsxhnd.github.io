---
import { siteConfig } from '../config/site';
import Seal from './Seal.astro';

interface Props {
  isHome?: boolean;
}

const { isHome = false } = Astro.props;
const currentPath = Astro.url.pathname;
const TitleTag = isHome ? 'h1' : 'p';

function isNavActive(url: string): boolean {
  return currentPath === url || (url !== '/' && currentPath.startsWith(url));
}
---

<header class="relative">
  <div class="relative flex items-start justify-center">
    <div class="w-full max-w-full text-center">
      <div class="flex items-center justify-center gap-2 sm:relative sm:inline-flex">
        <TitleTag class="site-title">
          <a href="/">{siteConfig.title}</a>
        </TitleTag>
        {siteConfig.seal && (
          <div class="shrink-0 sm:absolute sm:left-full sm:top-1/2 sm:ml-4 sm:-translate-y-1/2">
            <Seal text={siteConfig.sealText} />
          </div>
        )}
      </div>
      {siteConfig.subtitle && <p class="site-subtitle">{siteConfig.subtitle}</p>}
      <div class="mt-3 flex flex-wrap justify-center gap-2 sm:mt-4">
        {siteConfig.darkMode && (
          <button id="theme-toggle" type="button" class="header-pill-btn" aria-label="切换深色模式">
            <svg id="icon-light" class="size-3.5" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true">
              <circle cx="12" cy="12" r="4" stroke-width="1.5"/>
              <path d="M12 2v2M12 20v2M4.93 4.93l1.41 1.41M17.66 17.66l1.41 1.41M2 12h2M20 12h2" stroke-width="1.5" stroke-linecap="round"/>
            </svg>
            <svg id="icon-dark" class="size-3.5 hidden" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true">
              <path d="M21 12.79A9 9 0 1111.21 3 7 7 0 0021 12.79z" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"/>
            </svg>
          </button>
        )}
        <a href={siteConfig.social.rss} class="header-pill-btn" aria-label="RSS">
          <svg class="size-3.5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true">
            <path d="M4 11a9 9 0 0 1 9 9"/><path d="M4 4a16 16 0 0 1 16 16"/><circle cx="5" cy="19" r="1"/>
          </svg>
        </a>
        <button id="search-open" type="button" class="header-pill-btn" aria-label="搜索">
          <svg class="size-3.5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true">
            <circle cx="11" cy="11" r="7"/><path d="M21 21l-4.35-4.35"/>
          </svg>
        </button>
      </div>
    </div>
  </div>
</header>

<nav class="mt-6 sm:mt-8 md:mt-10" aria-label="主导航">
  <div class="flex items-center justify-center md:hidden">
    <button
      id="menu-btn"
      type="button"
      class="nav-menu-btn"
      aria-expanded="false"
      aria-controls="mobile-menu"
    >
      <span class="text-base leading-none tracking-widest">菜单</span>
      <svg id="menu-chevron" class="text-muted-light size-4 transition-transform duration-200" viewBox="0 0 20 20" fill="currentColor" aria-hidden="true">
        <path fill-rule="evenodd" d="M5.23 7.21a.75.75 0 0 1 1.06.02L10 10.94l3.71-3.71a.75.75 0 1 1 1.06 1.06l-4.24 4.24a.75.75 0 0 1-1.06 0L5.21 8.29a.75.75 0 0 1 .02-1.08z" clip-rule="evenodd" />
      </svg>
    </button>
  </div>

  <div class="hidden md:block">
    <ul class="flex flex-wrap items-center justify-center gap-x-6 gap-y-2 px-4 text-base">
      {siteConfig.menu.map((item, index) => (
        <>
          <li>
            <a
              href={item.url}
              class:list={['nav-link', { 'is-active': isNavActive(item.url) }]}
            >
              {item.name}
            </a>
          </li>
          {index < siteConfig.menu.length - 1 && (
            <li class="nav-separator" role="separator" aria-hidden="true">/</li>
          )}
        </>
      ))}
    </ul>
  </div>

  <div id="mobile-menu" class="menu-panel mt-4 md:hidden" data-open="false">
    <ul class="nav-mobile-panel">
      {siteConfig.menu.map((item, index) => (
        <>
          <li>
            <a href={item.url} class="nav-mobile-link">{item.name}</a>
          </li>
          {index < siteConfig.menu.length - 1 && (
            <li class="nav-mobile-divider" role="separator" aria-hidden="true"></li>
          )}
        </>
      ))}
    </ul>
  </div>
</nav>

<script>
  import { initMobileMenu, initThemeToggle } from '../scripts/site';

  initThemeToggle();
  initMobileMenu();
</script>
