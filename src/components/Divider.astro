---
import Ellipsis from '@lucide/astro/icons/ellipsis';

interface Props {
  class?: string;
}

const { class: className = 'my-6' } = Astro.props;
---

<div class:list={['divider', className]} aria-hidden="true">
  <div class="divider-line"></div>
  <Ellipsis class="divider-icon" size={16} stroke-width={1.5} />
  <div class="divider-line right"></div>
</div>
