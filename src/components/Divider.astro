---
interface Props {
  class?: string;
}

const { class: className = 'my-6' } = Astro.props;
---

<div class:list={['divider', className]} aria-hidden="true">
  <div class="divider-line"></div>
  <svg class="divider-icon" viewBox="0 0 40 10">
    <circle cx="20" cy="5" r="3" fill="currentColor" opacity="0.9" />
    <circle cx="4" cy="5" r="1.5" fill="currentColor" opacity="0.6" />
    <circle cx="36" cy="5" r="1.5" fill="currentColor" opacity="0.6" />
  </svg>
  <div class="divider-line right"></div>
</div>
