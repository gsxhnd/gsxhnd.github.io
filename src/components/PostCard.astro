---
import { formatDate } from '../utils/content';
import type { BlogPost } from '../utils/content';

interface Props {
  post: BlogPost;
}

const { post } = Astro.props;
const { title, description, pubDate, category, tags, cover } = post.data;
---

<article class="group bg-white dark:bg-slate-800 rounded-xl border border-slate-200 dark:border-slate-700 overflow-hidden hover:shadow-lg hover:-translate-y-1 transition-all duration-300">
  <a href={`/blog/${post.id}`} class="block">
    {cover && (
      <div class="aspect-video overflow-hidden">
        <img 
          src={cover} 
          alt={title}
          class="w-full h-full object-cover group-hover:scale-105 transition-transform duration-500"
          onerror="this.style.display='none'"
        />
      </div>
    )}
    
    <div class="p-5 sm:p-6">
      <div class="flex items-center gap-2 mb-3 text-xs text-slate-500 dark:text-slate-400">
        <span class="px-2 py-1 rounded-full bg-blue-50 text-blue-600 dark:bg-blue-900/30 dark:text-blue-400">
          {category}
        </span>
        <span>·</span>
        <time datetime={pubDate.toISOString()}>{formatDate(pubDate)}</time>
      </div>
      
      <h3 class="text-lg font-semibold text-slate-900 dark:text-slate-50 mb-2 group-hover:text-blue-600 dark:group-hover:text-blue-400 transition-colors line-clamp-2">
        {title}
      </h3>
      
      <p class="text-sm text-slate-600 dark:text-slate-300 line-clamp-2 mb-4">
        {description}
      </p>
      
      {tags.length > 0 && (
        <div class="flex flex-wrap gap-1.5">
          {tags.slice(0, 3).map((tag) => (
            <span class="px-2 py-0.5 text-xs rounded-full bg-slate-100 text-slate-600 dark:bg-slate-700 dark:text-slate-300">
              #{tag}
            </span>
          ))}
          {tags.length > 3 && (
            <span class="px-2 py-0.5 text-xs rounded-full bg-slate-100 text-slate-500 dark:bg-slate-700 dark:text-slate-400">
              +{tags.length - 3}
            </span>
          )}
        </div>
      )}
    </div>
  </a>
</article>
