---
import { formatDate } from '../utils/content';
import type { BlogPost } from '../utils/content';

interface Props {
  post: BlogPost;
}

const { post } = Astro.props;
const { title, description, created, category, tags } = post.data;
---

<article class="py-2">
  <header class="mb-4 text-center">
    <h2 class="post-title">
      <a href={`/blog/${post.id}`}>{title}</a>
    </h2>
    <p class="text-muted mt-2 text-sm">
      <time datetime={created.toISOString()}>{formatDate(created)}</time>
      {category && (
        <>
          <span class="text-muted-light mx-2">·</span>
          <a href={`/categories/${category}`} class="link-muted">{category}</a>
        </>
      )}
      {tags.length > 0 && (
        <>
          <span class="text-muted-light mx-2">·</span>
          {tags.map((tag, i) => (
            <>
              <a href={`/tags/${tag}`} class="link-muted">{tag}</a>
              {i < tags.length - 1 && <span class="text-muted-light">, </span>}
            </>
          ))}
        </>
      )}
    </p>
  </header>
  <div class="prose-shiro prose mx-auto">
    <p>{description}</p>
  </div>
  <div class="mt-6 text-center">
    <a href={`/blog/${post.id}`} class="btn-ink" aria-label={`阅读全文: ${title}`}>阅读全文</a>
  </div>
</article>
