---
import PageLayout from './PageLayout.astro';
import Divider from '../components/Divider.astro';
import { formatDate } from '../utils/content';

interface Props {
  title: string;
  description: string;
  pubDate: Date;
  updatedDate?: Date;
  category: string;
  tags: string[];
  cover?: string;
}

const { title, description, pubDate, updatedDate, category, tags, cover } = Astro.props;
---

<PageLayout title={title} description={description} image={cover} type="article">
  {cover && (
    <div class="mb-6 overflow-hidden rounded-lg sm:mb-8 sm:rounded-xl">
      <img src={cover} alt={title} class="h-48 w-full object-cover sm:h-64 md:h-80" loading="lazy" />
    </div>
  )}

  <header class="mb-6 text-center sm:mb-8">
    <h1 class="section-title">{title}</h1>
    <Divider class="my-6" />
    <p class="text-muted text-sm">
      <time datetime={pubDate.toISOString()}>{formatDate(pubDate)}</time>
      {updatedDate && (
        <>
          <span class="text-muted-light mx-2">·</span>
          <span>更新于 {formatDate(updatedDate)}</span>
        </>
      )}
      <span class="text-muted-light mx-2">·</span>
      <a href={`/categories/${category}`} class="link-muted">{category}</a>
    </p>
    {description && <p class="text-body-secondary mt-4">{description}</p>}
  </header>

  <div class="prose-shiro prose max-w-none">
    <slot />
  </div>

  {tags.length > 0 && (
    <footer class="section-divider mt-10">
      <div class="flex flex-wrap justify-center gap-2">
        {tags.map((tag) => (
          <a href={`/tags/${tag}`} class="tag-pill">{tag}</a>
        ))}
      </div>
      <div class="mt-8 text-center">
        <a href="/" class="btn-ink">返回文章列表</a>
      </div>
    </footer>
  )}
</PageLayout>
