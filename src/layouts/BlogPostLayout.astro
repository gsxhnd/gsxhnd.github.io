---
import PageLayout from './PageLayout.astro';
import Divider from '../components/Divider.astro';
import { formatDate } from '../utils/content';
import Clock from '@lucide/astro/icons/clock';
import Folder from '@lucide/astro/icons/folder';
import Tag from '@lucide/astro/icons/tag';
import RefreshCw from '@lucide/astro/icons/refresh-cw';

interface Props {
  title: string;
  description: string;
  created: Date;
  updated?: Date;
  category?: string;
  tags: string[];
  cover?: string;
  headings?: { depth: number; slug: string; text: string }[];
}

const { title, description, created, updated, category, tags, cover, headings = [] } = Astro.props;
const tocItems = headings.filter((heading) => heading.depth >= 2 && heading.depth <= 3);
---

<PageLayout title={title} description={description} image={cover} type="article">
  {cover && (
    <div class="mb-6 overflow-hidden rounded-lg sm:mb-8 sm:rounded-xl">
      <img src={cover} alt={title} class="h-48 w-full object-cover sm:h-64 md:h-80" loading="lazy" />
    </div>
  )}

  <header class="mb-6 text-center sm:mb-8">
    <h1 class="section-title">{title}</h1>
    <Divider class="my-6" />
    <p class="text-muted flex flex-wrap items-center justify-center gap-x-2 gap-y-1 text-sm">
      <span class="inline-flex items-center gap-1">
        <Clock class="meta-icon" aria-hidden="true" />
        <time datetime={created.toISOString()}>{formatDate(created)}</time>
      </span>
      {updated && (
        <>
          <span class="text-muted-light" aria-hidden="true">·</span>
          <span class="inline-flex items-center gap-1">
            <RefreshCw class="meta-icon" aria-hidden="true" />
            <span>更新于 {formatDate(updated)}</span>
          </span>
        </>
      )}
      {category && (
        <>
          <span class="text-muted-light" aria-hidden="true">·</span>
          <a href={`/categories/${category}`} class="link-muted inline-flex items-center gap-1">
            <Folder class="meta-icon" aria-hidden="true" />
            {category}
          </a>
        </>
      )}
    </p>
    {description && <p class="text-body-secondary mt-4">{description}</p>}
  </header>

  <div class="blog-post-grid">
    <article class="prose-shiro prose max-w-none">
      <slot />
    </article>
  </div>

  {tocItems.length > 0 && (
    <div slot="outside-paper" class="blog-post-toc-shell">
      <aside class="blog-post-toc" aria-label="文章目录">
        <p class="blog-post-toc__title">目录</p>
        <nav data-toc-nav>
          <ul class="blog-post-toc__list">
            {tocItems.map((item) => (
              <li class:list={{ 'is-sub': item.depth === 3 }}>
                <a href={`#${item.slug}`}>{item.text}</a>
              </li>
            ))}
          </ul>
        </nav>
      </aside>
    </div>
  )}

  {
    tocItems.length > 0 && (
      <script>
        (() => {
          const tocNav = document.querySelector('[data-toc-nav]');
          if (!tocNav) return;

          const links = Array.from(tocNav.querySelectorAll('a[href^="#"]'));
          if (!links.length) return;

          const headingMap = new Map();
          for (const link of links) {
            const href = link.getAttribute('href');
            if (!href) continue;
            const id = decodeURIComponent(href.slice(1));
            const heading = document.getElementById(id);
            if (heading) {
              headingMap.set(id, { link, heading });
            }
          }

          const entries = Array.from(headingMap.entries());
          if (!entries.length) return;

          const setActive = (id: string) => {
            for (const [key, item] of entries) {
              if (key === id) {
                item.link.setAttribute('aria-current', 'true');
              } else {
                item.link.removeAttribute('aria-current');
              }
            }
          };

          const observer = new IntersectionObserver(
            (observerEntries) => {
              const visible = observerEntries
                .filter((entry) => entry.isIntersecting)
                .sort((a, b) => a.boundingClientRect.top - b.boundingClientRect.top);
              if (visible.length > 0) {
                setActive(visible[0].target.id);
              }
            },
            {
              rootMargin: '-18% 0px -72% 0px',
              threshold: [0, 1],
            }
          );

          for (const [, { heading }] of entries) {
            observer.observe(heading);
          }

          setActive(entries[0][0]);
        })();
      </script>
    )
  }

  {tags.length > 0 && (
    <footer class="section-divider mt-10">
      <div class="flex flex-wrap items-center justify-center gap-2">
        <Tag class="meta-icon text-muted-light shrink-0" aria-hidden="true" />
        {tags.map((tag) => (
          <a href={`/tags/${tag}`} class="tag-pill">{tag}</a>
        ))}
      </div>
      <div class="mt-8 text-center">
        <a href="/" class="btn-ink">返回文章列表</a>
      </div>
    </footer>
  )}
</PageLayout>
