---
import BaseLayout from './BaseLayout.astro';
import { formatDate } from '../utils/content';

interface Props {
  title: string;
  description: string;
  pubDate: Date;
  updatedDate?: Date;
  category: string;
  tags: string[];
  cover?: string;
}

const { title, description, pubDate, updatedDate, category, tags, cover } = Astro.props;
---

<BaseLayout title={title} description={description} image={cover} type="article">
  <article class="max-w-3xl mx-auto px-4 sm:px-6 lg:px-8 py-12">
    <!-- Post Header -->
    <header class="mb-10">
      {cover && (
        <div class="mb-8 rounded-xl overflow-hidden">
          <img 
            src={cover} 
            alt={title}
            class="w-full h-64 sm:h-80 object-cover"
            onerror="this.style.display='none'"
          />
        </div>
      )}
      
      <div class="flex items-center gap-3 mb-4 text-sm text-slate-500 dark:text-slate-400">
        <a 
          href={`/categories/${category}`}
          class="px-3 py-1 rounded-full bg-blue-50 text-blue-600 dark:bg-blue-900/30 dark:text-blue-400 hover:bg-blue-100 dark:hover:bg-blue-900/50 transition-colors"
        >
          {category}
        </a>
        <span>·</span>
        <time datetime={pubDate.toISOString()}>{formatDate(pubDate)}</time>
        {updatedDate && (
          <>
            <span>·</span>
            <span>更新于 {formatDate(updatedDate)}</span>
          </>
        )}
      </div>
      
      <h1 class="text-3xl sm:text-4xl font-bold text-slate-900 dark:text-slate-50 mb-4 leading-tight">
        {title}
      </h1>
      
      <p class="text-lg text-slate-600 dark:text-slate-300 leading-relaxed">
        {description}
      </p>
    </header>
    
    <!-- Post Content -->
    <div class="prose prose-slate dark:prose-invert prose-lg max-w-none">
      <slot />
    </div>
    
    <!-- Post Footer -->
    <footer class="mt-16 pt-8 border-t border-slate-200 dark:border-slate-700">
      {tags.length > 0 && (
        <div class="flex flex-wrap gap-2">
          {tags.map((tag) => (
            <a
              href={`/tags/${tag}`}
              class="px-4 py-2 rounded-full bg-slate-100 text-slate-700 dark:bg-slate-800 dark:text-slate-300 hover:bg-slate-200 dark:hover:bg-slate-700 transition-colors text-sm"
            >
              #{tag}
            </a>
          ))}
        </div>
      )}
      
      <div class="mt-8 flex items-center justify-between">
        <a 
          href="/blog"
          class="inline-flex items-center gap-2 text-blue-600 dark:text-blue-400 hover:text-blue-700 dark:hover:text-blue-300 transition-colors"
        >
          <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="m15 18-6-6 6-6"/></svg>
          返回文章列表
        </a>
      </div>
    </footer>
  </article>
</BaseLayout>
