---
import PageLayout from '../layouts/PageLayout.astro';
import PageHeader from '../components/PageHeader.astro';
import { getAllPosts, formatDateShort, groupPostsByYear } from '../utils/content';

const posts = await getAllPosts();
const grouped = groupPostsByYear(posts);
---

<PageLayout title="归档" description="按时间轴浏览所有文章">
  <PageHeader
    title="文章归档"
    description={`共 ${posts.length} 篇文章，${grouped.length} 个年份`}
  />

  <div class="mx-auto max-w-2xl space-y-12 sm:space-y-16">
    {grouped.map(({ year, posts: yearPosts }) => (
      <section>
        <h2 class="section-heading">
          <svg class="text-muted-light size-4 shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 8v4l3 3m6-3a9 9 0 11-18 0 9 9 0 0118 0z"/>
          </svg>
          {year}
        </h2>
        <div class="space-y-4">
          {yearPosts.map((post) => (
            <article class="archive-item group">
              <time datetime={post.data.created.toISOString()} class="oldstyle-nums">
                {formatDateShort(post.data.created).replace(/-/g, '/')}
              </time>
              <h3>
                <a href={`/blog/${post.id}`} class="link-underline">{post.data.title}</a>
              </h3>
            </article>
          ))}
        </div>
      </section>
    ))}
  </div>
</PageLayout>
