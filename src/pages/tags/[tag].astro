---
import PageLayout from '../../layouts/PageLayout.astro';
import PageHeader from '../../components/PageHeader.astro';
import PostCard from '../../components/PostCard.astro';
import Divider from '../../components/Divider.astro';
import { getAllPosts, getAllTags } from '../../utils/content';

export async function getStaticPaths() {
  const tags = await getAllTags();
  return tags.map((tag) => ({ params: { tag } }));
}

const { tag } = Astro.params;
const allPosts = await getAllPosts();
const posts = allPosts.filter((post) => post.data.tags.includes(tag!));
const tags = await getAllTags();
---

<PageLayout title={`标签：${tag}`} description={`查看「${tag}」标签下的所有文章`}>
  <PageHeader title={`标签: ${tag}`} description={`共 ${posts.length} 篇文章`} />
  <div class="mb-8 flex flex-wrap justify-center gap-2">
    {tags.map((t) => (
      <a href={`/tags/${t}`} class:list={['tag-pill', { 'is-active': t === tag }]}>{t}</a>
    ))}
  </div>
  {posts.map((post, index) => (
    <>
      <PostCard post={post} />
      {index < posts.length - 1 && <Divider />}
    </>
  ))}
</PageLayout>
