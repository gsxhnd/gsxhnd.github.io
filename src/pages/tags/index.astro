---
import PageLayout from '../../layouts/PageLayout.astro';
import PageHeader from '../../components/PageHeader.astro';
import { getAllTags, getAllPosts, countTags } from '../../utils/content';

const tags = await getAllTags();
const posts = await getAllPosts();
const tagCounts = countTags(posts);
---

<PageLayout title="标签" description="浏览所有文章标签">
  <PageHeader title="标签" description={`共 ${tags.length} 个标签`} />
  <div class="flex flex-wrap justify-center gap-2" data-reveal-group>
    {tags.map((tag) => (
      <a href={`/tags/${tag}`} class="tag-pill" data-reveal>
        {tag}
        <span class="ml-1 text-xs opacity-60">{tagCounts[tag] ?? 0}</span>
      </a>
    ))}
  </div>
</PageLayout>
