---
import BaseLayout from '../../layouts/BaseLayout.astro';
import Header from '../../components/Header.astro';
import Footer from '../../components/Footer.astro';
import PostCard from '../../components/PostCard.astro';
import { getAllPosts } from '../../utils/content';

const posts = await getAllPosts();
---

<BaseLayout title="博客" description="浏览所有博客文章">
  <Header />
  
  <main class="min-h-screen">
    <div class="max-w-5xl mx-auto px-4 sm:px-6 lg:px-8 py-12 sm:py-16">
      <header class="mb-10">
        <h1 class="text-3xl sm:text-4xl font-bold text-slate-900 dark:text-slate-50 mb-4">
          全部文章
        </h1>
        <p class="text-slate-600 dark:text-slate-300">
          共 {posts.length} 篇文章，记录技术探索与生活感悟
        </p>
      </header>
      
      {posts.length > 0 ? (
        <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6">
          {posts.map((post) => (
            <PostCard post={post} />
          ))}
        </div>
      ) : (
        <div class="text-center py-20">
          <div class="text-6xl mb-4">📝</div>
          <h2 class="text-xl font-semibold text-slate-900 dark:text-slate-50 mb-2">暂无文章</h2>
          <p class="text-slate-500 dark:text-slate-400">文章正在撰写中，敬请期待...</p>
        </div>
      )}
    </div>
  </main>
  
  <Footer />
</BaseLayout>
