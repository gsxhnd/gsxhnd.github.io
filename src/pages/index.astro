---
import PageLayout from '../layouts/PageLayout.astro';
import PostCard from '../components/PostCard.astro';
import Divider from '../components/Divider.astro';
import { getAllPosts } from '../utils/content';

const posts = await getAllPosts();
---

<PageLayout title="全菜开发" isHome={true}>
  {posts.length > 0 ? (
    <section class="home-post-list" aria-label="文章列表">
      {posts.map((post, index) => (
        <div class="home-post-item" data-motion-index={index}>
          <PostCard post={post} />
          {index < posts.length - 1 && <Divider class="my-4 sm:my-5" />}
        </div>
      ))}
    </section>
  ) : (
    <p class="text-muted py-12 text-center">暂无文章，敬请期待...</p>
  )}
</PageLayout>

<script>
  import { animate, inView } from 'motion';

  const items = document.querySelectorAll<HTMLElement>('.home-post-item');
  const prefersReducedMotion = window.matchMedia('(prefers-reduced-motion: reduce)').matches;

  if (!prefersReducedMotion && items.length > 0) {
    items.forEach((item) => {
      item.style.opacity = '0';
      item.style.transform = 'translateY(14px)';
    });

    inView(
      '.home-post-item',
      (item) => {
        const index = Number((item as HTMLElement).dataset.motionIndex ?? 0);

        animate(
          item,
          { opacity: 1, transform: 'translateY(0px)' },
          {
            duration: 0.55,
            delay: Math.min(index * 0.05, 0.3),
            easing: [0.22, 1, 0.36, 1],
          },
        );
      },
      { margin: '0px 0px -12% 0px' },
    );
  }
</script>
