---
import PageLayout from '../layouts/PageLayout.astro';
import PostCard from '../components/PostCard.astro';
import Divider from '../components/Divider.astro';
import { getAllPosts } from '../utils/content';

const posts = await getAllPosts();
---

<PageLayout title="全菜开发" isHome={true}>
  {posts.length > 0 ? (
    <section class="home-post-list" aria-label="文章列表" data-reveal-group>
      {posts.map((post, index) => (
        <div class="home-post-item" data-reveal>
          <PostCard post={post} />
          {index < posts.length - 1 && <Divider class="my-4 sm:my-5" />}
        </div>
      ))}
    </section>
  ) : (
    <p class="text-muted py-12 text-center">暂无文章，敬请期待...</p>
  )}
</PageLayout>
