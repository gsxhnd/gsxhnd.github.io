---
import PageLayout from '../layouts/PageLayout.astro';
---

<PageLayout title="页面未找到" description="请求的页面不存在">
  <div class="flex flex-col items-center justify-center py-20 text-center" data-reveal-group>
    <p class="text-8xl font-light text-heading opacity-20">404</p>
    <h1 class="mt-4 text-xl font-bold text-heading" data-reveal>页面未找到</h1>
    <p class="text-muted mt-2 text-sm" data-reveal>你访问的页面不存在或已被移除</p>
    <a href="/" class="btn-ink mt-8" data-reveal>返回首页</a>
  </div>
</PageLayout>
